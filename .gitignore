# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# sandbox scratch names — root-scoped so a legit tests/ dir stays trackable
/test
/prompt

server.log
# Skills directory
/skills/

# local databases / runtime state
/db/*.db
*.pid

# local tool output
/tool-results/

# QA / verification screenshots at repo root (kept locally, not for the repo)
/qa*.png
/screenshot*.png
/verdict*.png
/final-*.png
# Local import staging (unpublished drafts, transform tooling) — never publish
/.staging/
# User upload working area (source ZIPs) — local only, not for the repo
/upload/
