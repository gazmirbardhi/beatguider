{
  "name": "beatguider",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "bun run content:gen && next dev -p 3000 2>&1 | tee dev.log",
    "content:gen": "bun run scripts/gen-content.ts",
    "build:static": "bun run content:gen && bun run scripts/optimize-images.ts && bun run gen:og && bun run gen:rss && next build",
    "build": "bun run build:static",
    "gen:og": "bun run scripts/gen-og.ts",
    "gen:rss": "bun run scripts/gen-rss.ts",
    "test": "bun run scripts/smoke.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@next/third-parties": "^16.4.6",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "satori": "^0.33.4",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
