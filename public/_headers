# BeatGuider BG-1 — Cloudflare static-asset headers (Pages / Workers
# Static Assets). Serves the ./out static export. No Content-Security-Policy
# header is set for the initial ad-free release; one will be added when
# advertising / analytics is decided (spec §22).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block

# Static assets — long cache, immutable fingerprinted URLs
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# OG images — long cache (7 days, same TTL as gear/article photos in
# next.config.ts dev headers), stable filenames
/og/*
  Cache-Control: public, max-age=604800

# Generated gear/article photos — long cache
/gear/*
  Cache-Control: public, max-age=604800
/articles/*
  Cache-Control: public, max-age=604800

# Fonts are self-hosted — bundled at build time by next/font (and vendored
# in public/fonts/ for OG generation). No third-party font CDN requests.

# HTML — short cache, must revalidate to pick up content updates
/*.html
  Cache-Control: public, max-age=0, must-revalidate
